prefix=./build/ffmpeg-x64
exec_prefix=${prefix}
libdir=./build/ffmpeg-x64/lib
includedir=./build/ffmpeg-x64/include

Name: libavcodec
Description: FFmpeg codec library
Version: 59.37.100
Requires: 
